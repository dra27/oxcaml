(include_subdirs unqualified)

; The library + C-stub definitions (and the install of the mangled .so) are
; generated into stub_dll.inc (from stub_dll.dune.in) by Makefile.common-ox,
; baking the runtime-id suffix into the C stub library name. The
; ocamlopt_flags.sexp rules stay here (the generated library references the
; local ocamlopt_flags.sexp).
(include stub_dll.inc)

; Regular OCaml Rule (first phase of bootstrapping)

(rule
 (targets ocamlopt_flags.sexp)
 (enabled_if
  (= %{context_name} "default"))
 (action
  (copy ocamlopt_upstream_flags.sexp %{targets})))

; OxCaml Rule

(rule
 (targets ocamlopt_flags.sexp)
 (enabled_if
  (= %{context_name} "main"))
 (action
  (copy ocamlopt_oxcaml_flags.sexp %{targets})))

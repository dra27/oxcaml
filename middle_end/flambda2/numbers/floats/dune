(include_subdirs unqualified)

; The library + C-stub definitions are generated into stub_dll.inc (from
; stub_dll.dune.in) by Makefile.common-ox, which bakes the runtime-id suffix
; into the C stub library name so this compiler's bytecode loads only its own
; dllflambda2_floats_stubs (a build-config value dune can't express as an
; (archive_name)/(foreign_archives) atom).
(include stub_dll.inc)

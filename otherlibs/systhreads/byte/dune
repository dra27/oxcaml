(copy_files# ../*.{c,h,ml,mli})

(alias
 (name C-only)
 (deps libthreads_stubs.a dllthreads_stubs.so))

(copy_files# ../../../runtime/sync_posix.h)

(library
 (name threads)
 (modes byte)
 (wrapped false)
 ; FIXME Fix warning 27 and -no-strict-sequence
 (flags
  (:standard -no-strict-sequence -g -bin-annot -w -27))
 (ocamlopt_flags
  (:standard (:include %{project_root}/ocamlopt_flags.sexp)))
 (libraries unix)
 (library_flags -linkall)
 (c_library_flags -lpthread)
 (foreign_stubs
  (language c)
  (names st_stubs)
  (flags
   ((:include %{project_root}/oc_cflags.sexp)
    (:include %{project_root}/sharedlib_cflags.sexp)
    (:include %{project_root}/oc_cppflags.sexp)))))

; Relink threads.cma from the modules (in link order) with the runtime-id
; suffixed stubs reference (see otherlibs/unix/dune); installed in place of
; dune's by otherlibs/systhreads/dune.
(rule
 (targets threads_reloc.cma)
 (deps
  .threads.objs/byte/thread.cmo
  .threads.objs/byte/multicore.cmo
  .threads.objs/byte/event.cmo)
 (action
  (run %{ocamlc} -a -o threads_reloc.cma
       .threads.objs/byte/thread.cmo .threads.objs/byte/multicore.cmo
       .threads.objs/byte/event.cmo
       -linkall -dllib-suffixed -lthreads_stubs
       -cclib -lthreads_stubs -cclib -lpthread)))

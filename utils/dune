; config.ml is assembled per dune context (see Makefile.common-ox). The
; [default] (boot) context is built by the system compiler, which lacks the
; %standard_library_default primitive, so it uses config.fixed_libdir.ml; the
; OxCaml-built [main]/[runtime_stdlib] contexts use config.relocatable.ml.
(rule
 (targets config.ml)
 (mode fallback)
 (enabled_if
  (= %{context_name} "default"))
 (deps config.generated.ml config.fixed_libdir.ml config.common.ml)
 (action
  (with-stdout-to
   %{targets}
   (system "cat %{deps}"))))

(rule
 (targets config.ml)
 (mode fallback)
 (enabled_if
  (or
   (= %{context_name} "main")
   (= %{context_name} "runtime_stdlib")))
 (deps config.generated.ml config.relocatable.ml config.common.ml)
 (action
  (with-stdout-to
   %{targets}
   (system "cat %{deps}"))))

(rule
 (targets domainstate.ml)
 (mode fallback)
 (deps
  (:conf ../Makefile.config)
  (:c domainstate.ml.c)
  (:tbl
   ../runtime/caml/domain_state.tbl)
  (glob_files
   ../runtime/caml/{config,m,s,compatibility}.h))
 (action
  (with-stdout-to
   %{targets}
   (bash
    "`grep '^CPP=' %{conf} | cut -d'=' -f2-` -I ../runtime/caml %{c}"))))

(rule
 (targets domainstate.mli)
 (mode fallback)
 (deps
  (:conf ../Makefile.config)
  (:c domainstate.mli.c)
  (:tbl
   ../runtime/caml/domain_state.tbl)
  (glob_files
   ../runtime/caml/{config,m,s,compatibility}.h))
 (action
  (with-stdout-to
   %{targets}
   (bash
    "`grep '^CPP=' %{conf} | cut -d'=' -f2-` -I ../runtime/caml %{c}"))))

(include_subdirs unqualified)

(library
 (name oxcaml_utils)
 ; FIXME Fix warning 27
 (flags
  (:standard -w -27))
 (ocamlopt_flags
  (:standard
   (:include %{project_root}/ocamlopt_flags.sexp)
   -O3))
 (libraries ocamlcommon)
 (modules doubly_linked_list file_sections lru))

(install
 (files
  (oxcaml_utils.a as compiler-libs/oxcaml_utils.a)
  (oxcaml_utils.cma as compiler-libs/oxcaml_utils.cma)
  (oxcaml_utils.cmxa as compiler-libs/oxcaml_utils.cmxa)
  (.oxcaml_utils.objs/byte/oxcaml_utils.cmi
   as
   compiler-libs/oxcaml_utils.cmi)
  (.oxcaml_utils.objs/byte/oxcaml_utils__Doubly_linked_list.cmi
   as
   compiler-libs/oxcaml_utils__Doubly_linked_list.cmi)
  (.oxcaml_utils.objs/byte/oxcaml_utils__Doubly_linked_list.cmti
   as
   compiler-libs/oxcaml_utils__Doubly_linked_list.cmti)
  (.oxcaml_utils.objs/byte/oxcaml_utils__Doubly_linked_list.cmt
   as
   compiler-libs/oxcaml_utils__Doubly_linked_list.cmt)
  (.oxcaml_utils.objs/native/oxcaml_utils__Doubly_linked_list.cmx
   as
   compiler-libs/oxcaml_utils__Doubly_linked_list.cmx)
  (.oxcaml_utils.objs/native/oxcaml_utils__Doubly_linked_list.o
   as
   compiler-libs/oxcaml_utils__Doubly_linked_list.o))
 (section lib)
 (package ocaml))
